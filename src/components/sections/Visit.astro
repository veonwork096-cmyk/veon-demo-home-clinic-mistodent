---
// Final point of every scenario: address, live status, week, three numbers, e-mail, route, Instagram.
// The request fields are shown, the send button is inactive (demo.md §6): no fake submission.
import Section from "../Section.astro";
import RoomPhoto from "../RoomPhoto.astro";
import StatusLine from "../StatusLine.astro";
import Icon from "../Icon.astro";
import FutureLink from "../FutureLink.astro";
import reception from "../../assets/img/photo-uzhgorod-6.jpg";
import { phones, mainPhone, email, address, mapUrl, instagram, week, futureServices, FUTURE } from "../../data/clinic";
---
<Section id="visit" class="section visit" rec="R-013">
  <div class="room-grid visit__grid">
    <RoomPhoto
      class="visit__media"
      src={reception}
      alt="Рецепція HomeClinic із написом «МістоДент» і адміністраторка біля стійки"
      widths={[390, 640, 900]}
      sizes="(min-width: 64em) 40vw, 100vw"
      mirror
      position="25% 30%"
    />
    <div class="visit__info">
      <h2>Фединця, 19, другий поверх</h2>
      <p class="visit__addr">{address.street}, {address.floor}, {address.city}, {address.postal}</p>
      <StatusLine class="visit__status" />
      <table class="week" data-week>
        <caption class="visually-hidden">Графік роботи</caption>
        <tbody>
          {week.map((d) => (
            <tr data-day={d.day}>
              <th scope="row"><abbr title={d.long}>{d.short}</abbr></th>
              <td class="num">{d.open}–{d.close}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="phones" role="list" aria-label="Телефони клініки" data-rec="R-001">
        {phones.map((p) => <li><a class="phones__link num" href={`tel:${p.tel}`}>{p.display}</a></li>)}
      </ul>
      <ul class="visit__links" role="list">
        <li><a class="link" href={`mailto:${email}`}><Icon name="mail" /><span>{email}</span></a></li>
        <li><a class="link" href={mapUrl} target="_blank" rel="noopener"><Icon name="pin" /><span>Маршрут у Google Maps</span><span class="visually-hidden">(нова вкладка)</span></a></li>
        <li><a class="link" href={instagram} target="_blank" rel="noopener"><Icon name="instagram" /><span>Instagram home.clinic_mistodent</span><span class="visually-hidden">(нова вкладка)</span></a></li>
      </ul>
    </div>

    <div class="request" data-rec="R-002">
      <div class="request__intro">
        <h3>Заявка на прийом</h3>
        <p class="muted">Онлайн-заявка з'явиться в повній версії сайту. Зараз запис — за телефоном <a class="request__tel num" href={`tel:${mainPhone.tel}`}>{mainPhone.display}</a> або e-mail <a class="request__tel" href={`mailto:${email}`}>{email}</a>.</p>
      </div>
      <div class="request__fields">
        <fieldset class="request__set" disabled aria-describedby="rq-note">
        <legend class="visually-hidden">Заявка на прийом</legend>
        <div class="field">
          <label for="rq-name">Ім'я</label>
          <input id="rq-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="rq-phone">Телефон</label>
          <input id="rq-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div class="field">
          <label for="rq-service">Послуга <span class="muted">(необов'язково)</span></label>
          <select id="rq-service" name="service">
            <option value="">Оберіть послугу</option>
            {futureServices.map((s) => <option>{s}</option>)}
          </select>
        </div>
          <div class="request__send">
            <button class="btn" type="button" disabled aria-describedby="rq-note">Надіслати заявку</button>
          </div>
        </fieldset>
        <p id="rq-note" class="request__note">Онлайн-заявка з'явиться в повній версії сайту</p>
        <FutureLink note={FUTURE} class="request__policy">Політика конфіденційності</FutureLink>
      </div>
    </div>
  </div>
</Section>

<style>
  .visit__grid { row-gap: var(--s-6); }
  .visit :global(.visit__media) { grid-column: full-start / full-end; aspect-ratio: 4 / 3; }
  .visit__info { display: grid; gap: var(--s-3); align-content: start; justify-items: start; }
  .visit__addr { font-size: var(--fs-lead); }
  .week { border-collapse: collapse; min-width: min(100%, 18rem); }
  .week th, .week td { padding: .375rem 0; text-align: left; font-weight: 400; border-bottom: 1px solid var(--color-decor); }
  .week th { padding-right: var(--s-6); }
  .week abbr { text-decoration: none; }
  .week tr.is-today th, .week tr.is-today td { color: var(--color-plum); font-weight: 600; }
  .week tr.is-today th { box-shadow: inset 4px 0 0 var(--color-plum); padding-left: var(--s-1); }
  .phones { display: grid; gap: .25rem; }
  .phones__link {
    display: inline-flex; align-items: center; min-height: 2.75rem; font: 600 clamp(1.5rem, 1.2rem + 1.2vw, 2rem)/1.2 var(--font-display);
    color: var(--color-plum); text-decoration: none;
    background: linear-gradient(var(--color-action), var(--color-action)) 0 calc(100% - .25rem) / 0 2px no-repeat;
    transition: background-size var(--dur-fast) var(--ease-out);
  }
  .phones__link:hover { background-size: 100% 2px; }
  .visit__links { display: grid; }
  .visit__links :global(.link) { overflow-wrap: anywhere; }

  .request { display: grid; gap: var(--s-4); padding-top: var(--s-6); border-top: 2px solid var(--color-plum); }
  .request__intro { display: grid; gap: var(--s-2); align-content: start; }
  .request__tel { color: var(--color-plum); font-weight: 600; white-space: nowrap; }
  .request__fields { display: grid; gap: var(--s-2); align-content: start; }
  .request__set { display: grid; gap: var(--s-3); min-width: 0; margin: 0; padding: 0; border: 0; }
  .field input:disabled, .field select:disabled { background: var(--color-bg); cursor: not-allowed; opacity: .75; }
  .field { display: grid; gap: .5rem; }
  .field label { font-weight: 500; }
  .field input, .field select {
    min-height: var(--btn-h); width: 100%; padding: 0 1rem; border: 1px solid var(--color-text-muted); border-radius: var(--radius);
    background: var(--color-bg); color: var(--color-text); font: 400 var(--fs-body)/1.4 var(--font-body);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .field input:hover, .field select:hover { border-color: var(--color-plum); }
  .field input:focus-visible, .field select:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; border-color: var(--color-plum); }
  .request__send { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .request__note { color: var(--color-text-muted); font-size: var(--fs-small); }

  @media (min-width: 48em) {
    .request__set { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .request__send { grid-column: 1 / -1; }
  }
  @media (min-width: 64em) {
    .visit :global(.visit__media) { grid-column: full-start / 7; grid-row: 1; aspect-ratio: auto; height: 100%; min-height: 40rem; }
    .visit__info { grid-column: 8 / c-end; grid-row: 1; }
    .request { grid-column: c-start / c-end; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: var(--s-8); margin-top: var(--s-6); }
    .request__set { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
