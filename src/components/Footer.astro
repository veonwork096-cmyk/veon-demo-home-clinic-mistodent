---
import { Image } from "astro:assets";
import logo from "../assets/img/new-logo-site.png";
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { phones, email, address, instagram, mapUrl, hoursLine, FUTURE } from "../data/clinic";
const pages = ["Послуги", "Лікарі", "Ціни", "Оплата частинами", "Технології", "Політика конфіденційності"];
---
<footer class="footer on-deep" id="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="#top" class="footer__logo" aria-label="MistoDent HomeClinic, на початок сторінки">
        <Image src={logo} alt="" width={160} height={72} widths={[160, 320]} sizes="160px" format="webp" loading="lazy" />
      </a>
      <p>Сімейна стоматологія в Ужгороді</p>
    </div>
    <div class="footer__col">
      <h2 class="footer__h">Адреса і графік</h2>
      <p>{address.street}, {address.floor}<br />{address.city}, {address.postal}</p>
      <p>{hoursLine}</p>
      <a class="link" href={mapUrl} target="_blank" rel="noopener"><Icon name="pin" /><span>Маршрут</span><span class="visually-hidden">(Google Maps, нова вкладка)</span></a>
    </div>
    <div class="footer__col">
      <h2 class="footer__h">Зв'язок</h2>
      <ul role="list" class="footer__list" data-rec="R-001">
        {phones.map((p) => <li><a class="footer__a num" href={`tel:${p.tel}`}>{p.display}</a></li>)}
        <li><a class="footer__a" href={`mailto:${email}`}>{email}</a></li>
        <li><a class="footer__a" href={instagram} target="_blank" rel="noopener">Instagram<span class="visually-hidden"> (нова вкладка)</span></a></li>
      </ul>
    </div>
    <nav class="footer__col" aria-label="Сторінки сайту">
      <h2 class="footer__h">Сторінки</h2>
      <ul role="list" class="footer__list">
        {pages.map((p) => <li><FutureLink note={FUTURE}>{p}</FutureLink></li>)}
      </ul>
    </nav>
  </div>
  <div class="container footer__base">
    <p>© MistoDent HomeClinic, частина мережі МістоДент</p>
  </div>
</footer>

<style>
  .footer { background: var(--color-plum); color: var(--color-on-deep); padding-block: var(--s-12) var(--s-4); }
  .footer__grid { display: grid; gap: var(--s-6); }
  .footer__logo { display: inline-block; border-radius: var(--radius); }
  .footer__logo :global(img) { width: 160px; height: auto; filter: brightness(0) invert(1); }
  .footer__brand { display: grid; align-content: start; gap: var(--s-2); justify-items: start; color: var(--color-peach); }
  .footer__col { display: grid; gap: var(--s-2); align-content: start; justify-items: start; }
  .footer__h { font: 600 var(--fs-small)/1.3 var(--font-body); color: var(--color-peach); }
  .footer__list { display: grid; gap: .125rem; }
  .footer__a {
    display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-on-deep); text-decoration: none;
    background: linear-gradient(var(--color-peach), var(--color-peach)) 0 calc(100% - .5rem) / 0 1px no-repeat;
    transition: background-size var(--dur-fast) var(--ease-out);
  }
  .footer__a:hover { background-size: 100% 1px; }
  .footer__base { margin-top: var(--s-8); padding-top: var(--s-3); border-top: 1px solid var(--color-text-muted); color: var(--color-peach); font-size: var(--fs-small); }
  @media (min-width: 48em) { .footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .footer__grid { grid-template-columns: minmax(0, 3fr) repeat(3, minmax(0, 3fr)); } }
</style>
